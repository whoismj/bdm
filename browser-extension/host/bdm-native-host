#!/usr/bin/env python3
"""
Native Messaging Host for Boring Download Manager (BDM) Browser Extension.
Communicates with Firefox, Zen, Chrome, Chromium, Brave via standard I/O (binary length prefix + JSON)
and relays download actions directly to the BDM daemon UNIX socket.
"""

import sys
import os
import json
import struct
import socket
import subprocess

SOCKET_PATHS = [
    f"/run/user/{os.getuid()}/bdm.sock",
    f"/run/user/{os.getuid()}/omarchy-dm.sock"
]

def get_active_socket():
    for p in SOCKET_PATHS:
        if os.path.exists(p):
            return p
    return None

def read_message():
    """Read a native message from standard input (4-byte length prefix)."""
    raw_length = sys.stdin.buffer.read(4)
    if not raw_length or len(raw_length) < 4:
        return None
    message_length = struct.unpack("@I", raw_length)[0]
    if message_length == 0 or message_length > 10 * 1024 * 1024:
        return None
    message_bytes = sys.stdin.buffer.read(message_length)
    if not message_bytes or len(message_bytes) < message_length:
        return None
    try:
        return json.loads(message_bytes.decode("utf-8"))
    except Exception as e:
        return {"error": f"Invalid JSON: {str(e)}"}

def send_message(response):
    """Write a native message to standard output (4-byte length prefix)."""
    try:
        encoded = json.dumps(response).encode("utf-8")
        sys.stdout.buffer.write(struct.pack("@I", len(encoded)))
        sys.stdout.buffer.write(encoded)
        sys.stdout.buffer.flush()
    except Exception:
        pass

def send_to_daemon_socket(request, timeout=3.0):
    """Send JSON request to BDM daemon UNIX socket and return JSON response."""
    sock_path = get_active_socket()
    if not sock_path:
        return None
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(timeout)
        client.connect(sock_path)
        payload = json.dumps(request).encode("utf-8") + b"\n"
        client.sendall(payload)

        data = b""
        while True:
            chunk = client.recv(4096)
            if not chunk:
                break
            data += chunk
            if b"\n" in chunk:
                break
        client.close()
        if data:
            return json.loads(data.decode("utf-8").strip())
    except Exception:
        return None
    return None

def start_bdm_if_needed():
    """Ensure BDM is running if socket does not exist."""
    if get_active_socket():
        return True
    try:
        # Launch BDM in background portably
        cmd = None
        for p in ["/usr/bin/bdm", "/usr/local/bin/bdm", os.path.expanduser("~/.local/bin/bdm")]:
            if os.path.exists(p) and os.access(p, os.X_OK):
                cmd = [p]
                break
        if not cmd:
            import shutil
            which_bdm = shutil.which("bdm")
            if which_bdm:
                cmd = [which_bdm]
            else:
                app_dir = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
                cmd = ["electron", "--enable-features=UseOzonePlatform", "--ozone-platform=wayland", app_dir]

        subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        return True
    except Exception:
        return False

def handle_request(req):
    action = req.get("action", "ping")

    if action == "ping":
        sock = get_active_socket()
        return {
            "status": "ok",
            "app": "BDM",
            "daemon_alive": sock is not None,
            "version": "2.0",
            "host": "bdm-native-host"
        }

    # If action is add or open_modal and daemon is not up, start BDM
    if not get_active_socket():
        start_bdm_if_needed()

    # Forward to daemon socket
    resp = send_to_daemon_socket(req)
    if resp is not None:
        return resp

    # Fallback if socket communication failed
    if action in ("add", "open_add_modal"):
        url = req.get("url")
        if url:
                cmd = ["bdm", "add", url, "--gui"]
                user_bin = os.path.expanduser("~/.local/bin/bdm")
                if os.path.exists(user_bin):
                    cmd = [user_bin, "add", url, "--gui"]
                subprocess.Popen(
                    cmd,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True
                )
                return {"status": "ok", "fallback": True, "message": "Dispatched via BDM CLI"}
            except Exception as e:
                return {"status": "error", "message": f"Failed fallback add: {e}"}

    return {"status": "error", "message": "BDM daemon is not reachable"}

def main():
    while True:
        req = read_message()
        if req is None:
            break
        resp = handle_request(req)
        send_message(resp)

if __name__ == "__main__":
    main()
